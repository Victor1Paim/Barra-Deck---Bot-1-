{
  "name": "deck-one",
  "version": "0.1.0",
  "description": "Deck One — assistente pessoal autônomo de terminal para as informações da empresa (notas, lembretes, base de conhecimento), com cérebro na API da OpenAI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "deck-one": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "openai": "^7.53.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
