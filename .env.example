# Copie para .env e preencha. Nunca faça commit do .env.
OPENAI_API_KEY=sk-...

# Modelo que serve de "cérebro". Troque à vontade.
OPENAI_MODEL=gpt-5.4-mini

# Modo de permissão: misto | perguntar | auto | leitura
#  misto     -> cria notas e lembretes sozinho; confirma antes de editar (padrão)
#  perguntar -> confirma qualquer gravação
#  auto      -> faz sozinho
#  leitura   -> só consulta, nunca grava
# Em QUALQUER modo: apagar e mexer no financeiro sempre pedem confirmação.
DECK_MODO=misto

# Criptografia dos dados (notas, lembretes). Gere com: npm run dev -- gerar-chave
# GUARDE UMA CÓPIA: sem a chave, os dados não abrem.
DECK_CHAVE_DADOS=

# Quem está usando o terminal (id em deck.config.json). Padrão: o primeiro admin.
DECK_USUARIO=

# E-mail (SMTP) para avisos. Gmail: smtp.gmail.com, porta 587, use uma "senha de app".
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=

# Caminhos (padrões: ./dados, ./conhecimento, ./skills, ./deck.config.json)
DECK_DADOS=./dados
DECK_CONHECIMENTO=./conhecimento
DECK_CONFIG=./deck.config.json

# Fuso horário usado para datas e lembretes
DECK_FUSO=America/Sao_Paulo

# Limite de passos por pedido (proteção contra loop infinito)
DECK_MAX_PASSOS=12
