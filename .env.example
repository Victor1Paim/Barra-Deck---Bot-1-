# Copie para .env e preencha. Nunca faça commit do .env.
OPENAI_API_KEY=sk-...

# Modelo que serve de "cérebro". Troque à vontade.
OPENAI_MODEL=gpt-5.4-mini

# Modo de permissão: perguntar | auto | leitura
#  perguntar -> pede confirmação antes de qualquer ação que grave/altere algo
#  auto      -> executa sozinho (mais autônomo)
#  leitura   -> só consulta, nunca grava
DECK_MODO=perguntar

# Pasta onde ficam notas e lembretes (JSON). Padrão: ./dados
DECK_DADOS=./dados

# Pasta com documentos da empresa que o bot pode ler. Padrão: ./conhecimento
DECK_CONHECIMENTO=./conhecimento

# Fuso horário usado para datas e lembretes
DECK_FUSO=America/Sao_Paulo

# Limite de passos por pedido (proteção contra loop infinito)
DECK_MAX_PASSOS=12
